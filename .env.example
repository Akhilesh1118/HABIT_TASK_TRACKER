# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CRON_SECRET: Optional secret key for securing background cron tasks
CRON_SECRET=""

# MONGODB_URI: MongoDB Atlas connection URI (e.g. mongodb+srv://user:pass@cluster.mongodb.net/tracker?retryWrites=true&w=majority)
MONGODB_URI=""

# JWT_SECRET: Strong secret key for signing secure HTTP-only session cookies
JWT_SECRET=""

# INITIAL_ADMIN_EMAIL: Email for your personal account
INITIAL_ADMIN_EMAIL="admin@example.com"

# INITIAL_ADMIN_PASSWORD: Initial password for your personal account (used on first initialization)
INITIAL_ADMIN_PASSWORD="ChangeMeSecurely123!"
