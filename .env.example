# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Google Identity Services OAuth Web Client ID (same value on server and browser).
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""

# CRON_SECRET: Optional secret key for securing background cron tasks
CRON_SECRET=""

# MONGODB_URI: MongoDB Atlas connection URI (e.g. mongodb+srv://user:pass@cluster.mongodb.net/tracker?retryWrites=true&w=majority)
MONGODB_URI=""

# JWT_SECRET: Unique secret of at least 16 characters; required in production/Vercel
JWT_SECRET=""

# INITIAL_ADMIN_EMAIL: Email for your personal account
INITIAL_ADMIN_EMAIL="admin@example.com"

# INITIAL_ADMIN_PASSWORD: Unique password of at least 16 characters; required in production/Vercel
INITIAL_ADMIN_PASSWORD=""
